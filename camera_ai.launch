<launch>
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <!-- CAMERA AI LAUNCH — OAK-D S2 CAMERA & VPU SPATIAL AI (THÀNH VIÊN 2)        -->
  <!-- Đồ án: JetBot Semantic SLAM & HRI (DepthAI + Myriad X VPU)                -->
  <!-- ═════════════════════════════════════════════════════════════════════════ -->

  <arg name="camera_name"      default="stereo_inertial_publisher"/>
  <arg name="parent_frame"     default="base_link"/>
  <arg name="cam_pos_x"        default="0.08"/>
  <arg name="cam_pos_y"        default="0.0"/>
  <arg name="cam_pos_z"        default="0.12"/>
  <arg name="mode"             default="depth"/>
  <arg name="lr_check"         default="true"/>
  <arg name="confidence"       default="200"/>

  <!-- 1. TỌA ĐỘ TĨNH TF2: base_link (tâm trục bánh xe) -> oak-d_frame (camera trước mũi) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_camera_tf"
        args="$(arg cam_pos_x) $(arg cam_pos_y) $(arg cam_pos_z) 0 0 0 $(arg parent_frame) oak-d_frame" />

  <!-- 2. KHỞI CHẠY CAMERA OAK-D S2 QUA USB 3.0 VỚI PIPELINE DEPTHAI TRÊN VPU MYRIAD X -->
  <!-- Sử dụng driver depthai_examples chuẩn ROS theo yêu cầu trong skill_tv2.md -->
  <include file="$(find depthai_examples)/launch/stereo_inertial_node.launch">
    <arg name="parent_frame" value="$(arg parent_frame)"/>
    <arg name="camera_name"  value="$(arg camera_name)"/>
    <arg name="mode"         value="$(arg mode)"/>
    <arg name="lr_check"     value="$(arg lr_check)"/>
    <arg name="confidence"   value="$(arg confidence)"/>
  </include>

</launch>
