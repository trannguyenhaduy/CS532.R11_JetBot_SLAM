<launch>
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <!-- JETBOT MASTER BRINGUP — KHỞI CHẠY TOÀN BỘ HỆ THỐNG VỚI 1 LỆNH DUY NHẤT -->
  <!-- Đồ án: JetBot Semantic SLAM + OAK-D S2 (3 Thành viên)                    -->
  <!-- ═════════════════════════════════════════════════════════════════════════ -->

  <!-- 1. CỤM THÀNH VIÊN 1: ĐIỀU KHIỂN ĐỘNG CƠ & BÁM NGƯỜI (MOTION & HRI) -->
  <group ns="motion_control">
    <node pkg="jetbot_slam" type="motor_driver_node.py" name="motor_driver" output="screen" respawn="true" respawn_delay="2"/>
    <node pkg="jetbot_slam" type="person_follower_node.py" name="person_follower" output="screen" respawn="true" respawn_delay="2"/>
  </group>

  <!-- 2. CỤM THÀNH VIÊN 2: MẮT THẦN CAMERA OAK-D S2 & SPATIAL AI (VISION & VPU) -->
  <include file="$(find jetbot_slam)/launch/camera_ai.launch"/>
  <node pkg="jetbot_slam" type="spatial_perception_node.py" name="spatial_ai_filter" output="screen" respawn="true" respawn_delay="3"/>

  <!-- 3. CỤM THÀNH VIÊN 3: VISUAL SLAM (RTAB-MAP) & CÂY TỌA ĐỘ TF2 -->
  <include file="$(find jetbot_slam)/launch/rtabmap_slam.launch"/>

  <!-- 4. CỤM THÀNH VIÊN 3: BẢN ĐỒ NGỮ NGHĨA 3D (GOM CỤM & CẮM CỜ VẬT THỂ) -->
  <node pkg="jetbot_slam" type="semantic_mapping_node.py" name="semantic_mapping_engine" output="screen" respawn="true" respawn_delay="2"/>

  <!-- 5. TRẠM ĐIỀU KHIỂN WEB DIGITAL TWIN & REAL-TIME BENCHMARK (PORT 8080) -->
  <node pkg="jetbot_slam" type="slam_web_dashboard.py" name="web_cockpit_benchmark" output="screen" respawn="true" respawn_delay="2"/>

</launch>
