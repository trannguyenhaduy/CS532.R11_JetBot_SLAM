<launch>
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <!-- CAMERA AI LAUNCH — OAK-D S2 CAMERA & VPU SPATIAL AI                       -->
  <!-- Node Python nội bộ trong repo jetbot_slam, ổn định 100% không phụ thuộc C++ -->
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <arg name="camera_model"   default="OAK-D-S2" />
  <arg name="confidence"     default="0.25" />

  <!-- 1. CÂY TỌA ĐỘ TF2: base_link -> oak-d_frame (camera trước mũi xe) -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_camera_tf"
        args="0.08 0.0 0.12 0 0 0 base_link oak-d_frame" />

  <!-- 2. NẠP THAM SỐ LÊN ROS PARAMETER SERVER -->
  <param name="/camera_model" value="$(arg camera_model)" />
  <param name="/confidence" value="$(arg confidence)" />

  <!-- 3. KHỞI CHẠY DRIVER CAMERA NỘI BỘ THUẦN PYTHON (CAMERA_NODE.PY) -->
  <node pkg="jetbot_slam" type="camera_node.py" name="oak_camera_publisher" output="screen" respawn="true" respawn_delay="2" />
</launch>
