<launch>
  <!-- ═════════════════════════════════════════════════════════════════════════ -->
  <!-- RTAB-MAP SLAM LAUNCH — VISUAL ODOMETRY & 2D/3D MAPPING (THÀNH VIÊN 3)      -->
  <!-- Đồ án: JetBot 3D Semantic SLAM (Tối ưu hóa cho Jetson Nano & OAK-D S2)    -->
  <!-- ═════════════════════════════════════════════════════════════════════════ -->

  <group ns="rtabmap">
    <!-- 1. RTAB-MAP CORE SLAM NODE -->
    <node name="rtabmap" pkg="rtabmap_ros" type="rtabmap" output="screen" args="--delete_db_on_start">
      <!-- Frame IDs -->
      <param name="frame_id"        type="string" value="base_link"/>
      <param name="odom_frame_id"   type="string" value="odom"/>
      <param name="map_frame_id"    type="string" value="map"/>

      <!-- Remap topics từ cụm OAK-D S2 của Thành viên 2 -->
      <remap from="rgb/image"       to="/stereo_inertial_publisher/color/image"/>
      <remap from="depth/image"     to="/stereo_inertial_publisher/stereo/depth"/>
      <remap from="rgb/camera_info" to="/stereo_inertial_publisher/color/camera_info"/>
      <remap from="odom"            to="/rtabmap/odom"/>
      <remap from="grid_map"        to="/rtabmap/grid_map"/>

      <!-- Cấu hình đồng bộ & bộ nhớ tối ưu cho Jetson Nano -->
      <param name="subscribe_depth"        type="bool"   value="true"/>
      <param name="subscribe_odom_info"    type="bool"   value="false"/>
      <param name="approx_sync"            type="bool"   value="true"/>
      <param name="queue_size"             type="int"    value="10"/>

      <!-- Tần số cập nhật RTAB-Map -->
      <param name="Rtabmap/DetectionRate"  type="string" value="5.0"/>
      <param name="Mem/IncrementalMemory"  type="string" value="true"/>
      <param name="Mem/InitWMWithAllNodes" type="string" value="false"/>

      <!-- Cập nhật chuyển động & Lưới Occupancy -->
      <param name="RGBD/LinearUpdate"      type="string" value="0.05"/>
      <param name="RGBD/AngularUpdate"     type="string" value="0.05"/>
      <param name="Reg/Strategy"           type="string" value="0"/>
      <param name="Vis/MinInliers"         type="string" value="12"/>
      <param name="Grid/CellSize"          type="string" value="0.05"/>
    </node>

    <!-- 2. RGB-D VISUAL ODOMETRY -->
    <node pkg="rtabmap_ros" type="rgbd_odometry" name="rgbd_odometry" output="screen">
      <remap from="rgb/image"       to="/stereo_inertial_publisher/color/image"/>
      <remap from="depth/image"     to="/stereo_inertial_publisher/stereo/depth"/>
      <remap from="rgb/camera_info" to="/stereo_inertial_publisher/color/camera_info"/>
      <remap from="odom"            to="/rtabmap/odom"/>

      <param name="frame_id"        type="string" value="base_link"/>
      <param name="odom_frame_id"   type="string" value="odom"/>
      <param name="approx_sync"     type="bool"   value="true"/>
      <param name="queue_size"      type="int"    value="10"/>
      <param name="Odom/Strategy"   type="string" value="0"/>
    </node>
  </group>
</launch>
